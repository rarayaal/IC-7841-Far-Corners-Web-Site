# Opcional: copiar estas variables al backend/.env existente sin borrar las demás.
MYMEMORY_ENABLED=true
# Vacío: cuota anónima. Correo válido de contacto: cuota ampliada del proveedor.
MYMEMORY_EMAIL=
# Vacío: límite local de 4500 caracteres/día, o 45000 con correo válido.
MYMEMORY_DAILY_CHAR_LIMIT=
# Opcional. Por defecto: carpeta del usuario, fuera del repositorio y de PostgreSQL.
# MYMEMORY_CACHE_FILE=C:/Users/TU_USUARIO/.cache/farcorners-mymemory/cache.json
