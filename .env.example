# Copiar a .env (raiz del proyecto) para que docker-compose lo lea.
# Cloudflare R2 -> R2 Object Storage -> Manage API Tokens (permiso Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL publica del bucket (dominio propio o r2.dev), sin "/" final.
R2_PUBLIC_URL=
